---
type Props = {
  readonly from: string;
};

const { from } = Astro.props;
const target = "/about/";
const canonical = new URL(target, Astro.site).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>{from} page moved | Marceline Belardo</title>
  </head>
  <body>
    <main>
      <h1>{from} page moved</h1>
      <p>The {from.toLowerCase()} page is now at <a href={target}>About</a>.</p>
    </main>
  </body>
</html>
