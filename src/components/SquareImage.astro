---
// pattern: Imperative Shell
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type SharedProps = {
  readonly src: ImageMetadata;
  readonly class?: string;
  readonly priority?: boolean;
  readonly sizes?: string;
};

type Props =
  | (SharedProps & {
      readonly alt: string;
      readonly decorative?: false;
    })
  | (SharedProps & {
      readonly alt: "";
      readonly decorative: true;
    });

const {
  src,
  alt,
  decorative = false,
  class: className,
  priority = false,
  sizes = "auto",
} = Astro.props;

if (alt === "" && decorative !== true) {
  throw new Error("SquareImage requires decorative={true} when alt is empty");
}
---

<div class:list={["square-image", className]} style="aspect-ratio: 1;">
  <Image
    src={src}
    alt={alt}
    class="square-image__image"
    widths={[320, 640, 960, 1280]}
    sizes={sizes}
    layout="constrained"
    priority={priority}
    fit="contain"
    style="object-fit: contain;"
  />
</div>

<style>
  .square-image {
    display: block;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-rule) 18%, var(--color-paper));
  }

  .square-image__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
