---
// pattern: Imperative Shell
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  filterPublishedEntries,
  sortByDateDescending,
} from "../../../content/content-queries.ts";

type Props = {
  readonly tag: string;
};

export async function getStaticPaths() {
  const posts = filterPublishedEntries(
    await getCollection("blog"),
    !import.meta.env.DEV,
  );
  const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];
  return tags.map((tag) => ({
    params: { tag: tag.toLowerCase() },
    props: { tag },
  }));
}

const { tag } = Astro.props as Props;
const allPosts: Array<CollectionEntry<"blog">> = await getCollection("blog");

const posts = sortByDateDescending(
  filterPublishedEntries(allPosts, !import.meta.env.DEV).filter(
    (post) =>
      post.data.tags?.some((postTag) => postTag.toLowerCase() === tag.toLowerCase()) ??
      false,
  ),
);
---

<BaseLayout
  title={`Posts tagged: ${tag}`}
  description={`Writing by Marceline Belardo tagged with ${tag}.`}
>
  <section class="py-12 mx-auto max-w-2xl">
    <a href="/blog/" class="text-sm text-neutral-500 hover:text-neutral-700 no-underline"
      >&larr; Back to Blog</a
    >
    <h1 class="text-3xl font-bold text-neutral-900 mt-4 mb-8">
      Posts tagged: <span class="text-neutral-500">{tag}</span>
    </h1>
    {
      posts.length === 0 ? (
        <p class="text-neutral-600">No posts found.</p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <h2 class="text-xl font-bold mb-1">{post.data.title}</h2>
              </a>
              <time
                class="text-sm text-neutral-500"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              {post.data.description && (
                <p class="font-medium text-red-500 mt-1 leading-relaxed">
                  {post.data.description}
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
