---
// pattern: Imperative Shell
import GlowText from "../../components/GlowText.astro";
import BlogIndexEntry from "../../components/BlogIndexEntry.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/blog-design.css";
import { getCollection, type CollectionEntry } from "astro:content";
import { getPublishedBlogPosts } from "../../content/content-queries.ts";

const posts: Array<CollectionEntry<"blog">> = getPublishedBlogPosts(
  await getCollection("blog"),
  !import.meta.env.DEV,
);
---

<BaseLayout
  title="Blog"
  description="Writing by Marceline Belardo about technology, politics, and art."
>
  <article class="editorial-page blog-index-page">
    <header class="blog-index__header">
      <h1 data-ink-hover="text"><GlowText>Blog</GlowText></h1>
      <a href="/rss.xml" class="blog-index__rss">RSS feed</a>
    </header>
    {
      posts.length === 0 ? (
        <p class="editorial-empty">No posts yet.</p>
      ) : (
        <ol class="blog-index__list" aria-label="Published writing">
          {posts.map((post) => (
            <li>
              <BlogIndexEntry post={post} />
            </li>
          ))}
        </ol>
      )
    }
  </article>
</BaseLayout>
