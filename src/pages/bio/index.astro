---
// pattern: Imperative Shell
import { Image } from "astro:assets";
import portraitImage from "../../assets/marcy_mirror.jpg";
import "../../styles/bio-design.css";
import "../../styles/ink-hover.css";
import BaseLayout from "../../layouts/BaseLayout.astro";

const bioContent = {
  label: "Software developer",
  introduction: "I’m Marceline, an independent software developer in Manila since July 2023. I build web and desktop applications, networking tools, and command-line software, mostly in Rust, TypeScript, Python, and C. Paid work includes a Next.js and TypeScript photography frontend and Python NLP sentiment charts for a journalist.",
  work: "My open-source work includes tree-based window management and directional navigation in fht-compositor, five merged pull requests for Starship, and my own local-first Rust desktop application chikachika, C HTTP server lilyhttpd, and Rust Huffman compressor cmprsr-rs.",
  statement: "Before software, I studied Film at UP Diliman and worked as a senior content editor leading six or seven writers. I graduated with a BA in Film in 2019 and am pursuing a Diploma in Computer Science at UPOU, expected in 2028. Writing, photography, and painting remain part of what I do.",
  skills: [
    "C",
    "Rust",
    "Java",
    "TypeScript",
    "React",
    "Python",
    "PostgreSQL",
  ],
  portraitAlt: "Marceline Belardo taking a mirror photograph with a camera",
};
const portraitSizes = "(min-width: 55rem) 15vw, (min-width: 35rem) 18vw, 30vw";
---
<BaseLayout
  title="Bio"
  description="About Marceline Belardo, a software developer working across software, visual culture, research, and writing."
>
  <article class="bio-page">
    <header class="bio-title"><h1 data-ink-hover="text">Bio</h1><p>{bioContent.label}</p></header>
    <div class="bio-introduction">
      <p>{bioContent.introduction}</p>
      <p>{bioContent.work}</p>
      <a data-ink-hover="text" href="/marceline-belardo-cv.pdf" target="_blank" rel="noopener noreferrer">View CV (PDF)</a>
    </div>
    <div class="bio-portrait-triptych" aria-label="Marceline taking a mirror photograph">
      <figure class="bio-portrait-frame">
        <Image
          src={portraitImage}
          alt={bioContent.portraitAlt}
          class="bio-portrait-frame__image"
          widths={[320, 640, 960, 1280]}
          sizes={portraitSizes}
          layout="constrained"
          priority
          fit="contain"
          style="object-fit: contain;"
        />
      </figure>
      <figure class="bio-portrait-frame">
        <Image
          src={portraitImage}
          alt=""
          class="bio-portrait-frame__image"
          widths={[320, 640, 960, 1280]}
          sizes={portraitSizes}
          layout="constrained"
          fit="contain"
          style="object-fit: contain;"
        />
      </figure>
      <figure class="bio-portrait-frame">
        <Image
          src={portraitImage}
          alt=""
          class="bio-portrait-frame__image"
          widths={[320, 640, 960, 1280]}
          sizes={portraitSizes}
          layout="constrained"
          fit="contain"
          style="object-fit: contain;"
        />
      </figure>
    </div>
    <section class="bio-practice" aria-label="Approach">
      <p>{bioContent.statement}</p>
    </section>
    <section class="bio-tools" aria-labelledby="skills-heading">
      <h2 id="skills-heading" data-ink-hover="text">Tools and languages</h2>
      <p>{bioContent.skills.join(" · ")}</p>
    </section>
  </article>
</BaseLayout>

<script>
  import { initializeInkHover } from "../../scripts/ink-hover.ts";

  initializeInkHover();
</script>
