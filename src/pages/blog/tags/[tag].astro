---
// pattern: Imperative Shell
import GlowText from "../../../components/GlowText.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogIndexEntry from "../../../components/BlogIndexEntry.astro";
import "../../../styles/blog-design.css";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  getBlogTagArchives,
  type BlogTagArchive,
} from "../../../content/content-queries.ts";

type Props = {
  readonly tag: BlogTagArchive<CollectionEntry<"blog">>;
};

export async function getStaticPaths() {
  const archives = getBlogTagArchives(
    await getCollection("blog"),
    !import.meta.env.DEV,
  );

  return archives.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props as Props;
const { label, posts } = tag;
---

<BaseLayout
  title={`Posts tagged: ${label}`}
  description={`Writing by Marceline Belardo tagged with ${label}.`}
>
  <article class="editorial-page blog-index-page">
    <header class="blog-index__header">
      <h1 data-ink-hover="text"><GlowText>Posts tagged: {label}</GlowText></h1>
      <a href="/rss.xml" class="blog-index__rss">RSS feed</a>
    </header>
    {
      <ol class="blog-index__list" aria-label={`Posts tagged ${label}`}>
        {posts.map((post) => (
          <li>
            <BlogIndexEntry post={post} />
          </li>
        ))}
      </ol>
    }
  </article>
</BaseLayout>
