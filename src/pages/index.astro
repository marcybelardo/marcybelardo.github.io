---
import PhotoStudy from "../components/PhotoStudy.astro";
import "../styles/home-design.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_ORIGIN } from "../site-config.ts";
const canonicalUrl = new URL("/", Astro.site ?? SITE_ORIGIN).toString();
const profileUrls = [
  "https://github.com/marcybelardo",
  "https://bsky.app/profile/marcelinebelardo.com",
  "https://instagram.com/marcelinebelardo",
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: "Marceline Belardo",
    },
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      url: canonicalUrl,
      name: "Marceline Belardo",
      sameAs: profileUrls,
    },
  ],
};
const enableMotifPreview = import.meta.env.DEV;
---
<BaseLayout
  title="Marceline Belardo"
  description="Marceline Belardo is a software developer, photographer, and painter."
  structuredData={structuredData}
>
  <article class="portfolio-home" data-motif="brackets">
    {enableMotifPreview && (
      <script is:inline>
        (() => {
          const home = document.querySelector(".portfolio-home");
          const motif = new URLSearchParams(window.location.search).get("motif");

          if (
            home instanceof HTMLElement &&
            (motif === "brackets" || motif === "spine" || motif === "disc")
          ) {
            home.dataset.motif = motif;
          }
        })();
      </script>
    )}
    <div class="home-motif" aria-hidden="true">
      <span class="home-motif__bracket home-motif__bracket--top"></span>
      <span class="home-motif__bracket home-motif__bracket--bottom"></span>
      <span class="home-motif__spine"></span>
      <span class="home-motif__disc"></span>
    </div>
    <h1>Marceline Belardo</h1>
    <PhotoStudy />
    <nav class="home-directions" aria-label="Explore the site">
      <a href="/projects/">Projects</a>
      <a href="/blog/">Blog</a>
      <a href="/bio/">Bio</a>
      <a href="/contact/">Contact</a>
    </nav>
  </article>
</BaseLayout>
