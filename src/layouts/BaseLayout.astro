---
// pattern: Imperative Shell
import "../styles/global.css";
import BskyLogo from "../assets/bsky.svg";
import GithubLogo from "../assets/GitHub_Invertocat_Black.svg";
import InstagramLogo from "../assets/Instagram_Glyph_Black.svg";
import {
  composeSiteTitle,
  createCanonicalUrl,
  createSocialImageUrl,
  serializeJsonLd,
  SITE_ORIGIN,
  validateCanonicalUrl,
} from "../metadata/page-metadata.ts";
import { validateStandardSiteDocumentUri } from "../site-config.ts";
const path = Astro.url.pathname;

const primaryLinks = [
  { label: "Projects", href: "/projects/" },
  { label: "Blog", href: "/blog/" },
  { label: "Bio", href: "/bio/" },
  { label: "Contact", href: "/contact/" },
];

type Props = {
  readonly title: string;
  readonly description: string;
  readonly canonicalPath?: string;
  readonly canonicalUrl?: string;
  readonly robots?: string;
  readonly metaRefreshPath?: string;
  readonly socialImage?: string;
  readonly socialImageAlt?: string;
  readonly socialType?: "website" | "article";
  readonly standardSiteDocument?: string | null;
  readonly structuredData?: Readonly<Record<string, unknown>>;
};

const {
  title,
  description,
  canonicalPath,
  canonicalUrl,
  robots,
  metaRefreshPath,
  socialImage,
  socialImageAlt,
  socialType = "website",
  standardSiteDocument,
  structuredData,
} = Astro.props;
const renderedTitle = composeSiteTitle(title);
const canonical =
  canonicalUrl !== undefined
    ? validateCanonicalUrl(canonicalUrl, SITE_ORIGIN)
    : createCanonicalUrl(canonicalPath ?? Astro.url.pathname, SITE_ORIGIN);
if (metaRefreshPath !== undefined) {
  createCanonicalUrl(metaRefreshPath, SITE_ORIGIN);
}
const refreshPath = metaRefreshPath ?? null;
const socialImageUrl = socialImage
  ? createSocialImageUrl(socialImage, SITE_ORIGIN)
  : null;
const standardSiteDocumentUri = standardSiteDocument
  ? validateStandardSiteDocumentUri(standardSiteDocument)
  : null;
---

<html lang="en">
  <head>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-N4JNKN2H');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4EKN42R6PS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-4EKN42R6PS');
    </script>

    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{renderedTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {standardSiteDocumentUri && (
      <link rel="site.standard.document" href={standardSiteDocumentUri} />
    )}
    <meta property="og:type" content={socialType} />
    <meta property="og:title" content={renderedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && socialImageAlt && (
      <meta property="og:image:alt" content={socialImageAlt} />
    )}
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={renderedTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && socialImageAlt && (
      <meta name="twitter:image:alt" content={socialImageAlt} />
    )}
    {robots && <meta name="robots" content={robots} />}
    {refreshPath && (
      <meta http-equiv="refresh" content={`0; url=${refreshPath}`} />
    )}
    {structuredData && (
      <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    )}
  </head>
  <body class="editorial-shell">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N4JNKN2H"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <header class="site-header">
      <div class="site-header__inner">
        <nav
          class="primary-navigation"
          aria-label="Primary"
          data-site-navigation
        >
          <a
            href="/"
            class="site-brand no-underline"
            aria-current={path === "/" ? "page" : undefined}
          >
            Marceline Belardo
          </a>
          <button
            type="button"
            class="primary-navigation__menu-button"
            id="primary-menu-button"
            aria-controls="primary-navigation"
            aria-expanded="true"
            aria-label="Close primary navigation"
            data-menu-button
          >
            Menu
          </button>
          <div class="primary-navigation__panel" id="primary-navigation" data-open="true">
            <ul class="primary-navigation__list">
              {
                primaryLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="primary-navigation__link"
                      aria-current={path === link.href ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
      </div>
    </header>

    <main class="editorial-main">
      <slot />
    </main>

    <footer class="social-links" aria-label="Social links">
      <a
        href="https://bsky.app/profile/marcelinebelardo.com"
        class="no-underline"
        aria-label="Bluesky"
        title="Bluesky"
      >
        <BskyLogo width={20} height={20} />
      </a>
      <a
        href="https://instagram.com/marcelinebelardo"
        class="no-underline"
        aria-label="Instagram"
        title="Instagram"
      >
        <InstagramLogo width={20} height={20} />
      </a>
      <a
        href="https://github.com/marcybelardo"
        class="no-underline"
        aria-label="GitHub"
        title="GitHub"
      >
        <GithubLogo width={20} height={20} />
      </a>
    </footer>

    <script>
      // pattern: Imperative Shell
      const navigation = document.querySelector("[data-site-navigation]");

      if (navigation instanceof HTMLElement) {
        navigation.dataset.jsReady = "true";
        const menuButton = navigation.querySelector("[data-menu-button]");
        const menuPanel = navigation.querySelector("[data-open]");
        const firstLink = menuPanel?.querySelector("a");
        const compactLayout = window.matchMedia("(max-width: 47.999rem)");
        let isOpen = false;
        let removeListeners = () => {};

        if (
          menuButton instanceof HTMLButtonElement &&
          menuPanel instanceof HTMLElement
        ) {
          const setPanelState = (open: boolean) => {
            const shouldShowPanel = !compactLayout.matches || open;

            menuPanel.dataset.open = String(shouldShowPanel);
            menuPanel.setAttribute("aria-hidden", String(!shouldShowPanel));
            menuPanel.toggleAttribute("inert", !shouldShowPanel);
            menuButton.setAttribute("aria-expanded", String(shouldShowPanel));
            menuButton.setAttribute(
              "aria-label",
              shouldShowPanel ? "Close primary navigation" : "Open primary navigation",
            );
          };

          const closeMenu = (restoreFocus: boolean) => {
            isOpen = false;
            setPanelState(false);

            if (restoreFocus) {
              window.requestAnimationFrame(() => {
                menuButton.focus();
              });
            }
          };

          const openMenu = () => {
            if (!compactLayout.matches) {
              return;
            }

            isOpen = true;
            setPanelState(true);
            window.requestAnimationFrame(() => {
              firstLink?.focus();
            });
          };

          const handleButtonClick = () => {
            if (isOpen) {
              closeMenu(true);
            } else {
              openMenu();
            }
          };

          const handleDocumentClick = (event: MouseEvent) => {
            if (
              isOpen &&
              event.target instanceof Node &&
              !navigation.contains(event.target)
            ) {
              closeMenu(true);
            }
          };

          const handleKeydown = (event: KeyboardEvent) => {
            if (event.key === "Escape" && isOpen) {
              closeMenu(true);
            }
          };

          const handleMediaChange = () => {
            if (!compactLayout.matches) {
              isOpen = false;
            }

            setPanelState(isOpen);
          };

          const handleLinkClick = () => {
            closeMenu(false);
          };

          menuButton.addEventListener("click", handleButtonClick);
          document.addEventListener("click", handleDocumentClick);
          document.addEventListener("keydown", handleKeydown);
          compactLayout.addEventListener("change", handleMediaChange);
          menuPanel.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", handleLinkClick);
          });
          setPanelState(false);

          removeListeners = () => {
            menuButton.removeEventListener("click", handleButtonClick);
            document.removeEventListener("click", handleDocumentClick);
            document.removeEventListener("keydown", handleKeydown);
            compactLayout.removeEventListener("change", handleMediaChange);
            menuPanel.querySelectorAll("a").forEach((link) => {
              link.removeEventListener("click", handleLinkClick);
            });
          };
        }

        document.addEventListener("astro:before-swap", removeListeners, {
          once: true,
        });
      }
    </script>
  </body>
</html>
