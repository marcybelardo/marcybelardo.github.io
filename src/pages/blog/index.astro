---
// pattern: Imperative Shell
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  filterPublishedEntries,
  sortByDateDescending,
} from "../../content/content-queries.ts";

const posts: Array<CollectionEntry<"blog">> = sortByDateDescending(
  filterPublishedEntries(await getCollection("blog"), !import.meta.env.DEV),
);
---

<BaseLayout
  title="Blog"
  description="Writing by Marceline Belardo about technology, politics, and art."
>
  <section class="py-12 mx-auto max-w-2xl">
    <h1 class="text-3xl font-bold text-neutral-900 mb-6">
      Blog
      <a href="/rss.xml" class="text-sm font-normal align-middle ml-3">RSS</a>
    </h1>
    {
      posts.length === 0 ? (
        <p class="text-neutral-600">No posts yet.</p>
      ) : (
        <ul class="space-y-8">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <h2 class="text-xl font-bold mb-1">{post.data.title}</h2>
              </a>
              <time
                class="text-sm text-neutral-500"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              {post.data.description && (
                <p class="font-medium text-red-500 mt-1 leading-relaxed">
                  {post.data.description}
                </p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <p class="text-xs text-neutral-400 mt-1">
                  {post.data.tags.map((tag: string, i: number) => [
                    i > 0 && ", ",
                    <a
                      href={`/blog/tags/${tag.toLowerCase()}/`}
                      class="hover:text-neutral-600 underline"
                    >
                      {tag}
                    </a>,
                  ])}
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
