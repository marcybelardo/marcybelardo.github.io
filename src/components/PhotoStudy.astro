---
import { Image } from "astro:assets";
import electric from "../assets/tokyo_electric.jpg";
import shibuya from "../assets/tokyo_shibuya.jpg";
import portrait from "../assets/homepage-photo.jpg";

const photos = [
  { src: electric, alt: "Utility poles and overhead wires against a blue sky in Tokyo" },
  { src: shibuya, alt: "Crowds beneath colorful billboards and storefronts in Shibuya, Tokyo" },
  { src: portrait, alt: "Marceline Belardo wearing glasses in a courtyard with golden-roofed buildings" },
];
---
<figure class="home-photograph">
  {photos.map(({ src, alt }) => (
    <div class="home-photograph__frame">
      <Image src={src} alt={alt} width={960} height={960} widths={[240, 480, 720, 960]}
        sizes="33.33vw" layout="constrained" fit="cover" priority class="home-photograph__image" />
    </div>
  ))}
</figure>
