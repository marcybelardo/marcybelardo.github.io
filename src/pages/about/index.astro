---
// pattern: Imperative Shell
import { Image } from "astro:assets";
import GlowText from "../../components/GlowText.astro";
import portraitImage from "../../assets/marcy_mirror.jpg";
import "../../styles/about-design.css";
import BaseLayout from "../../layouts/BaseLayout.astro";

const aboutContent = {
    introduction:
        "I’m Marceline, a software engineer focusing on designing reliable systems and workflows. I've worked in open source, maintained some projects of my own, and built web apps and data analysis pipelines for clients. I'm now focused on exploring modern AI development, especially around harness engineering and skill deployment.",
    work: "I work with Rust, Python, and TypeScript most often, but I'm capable in many different languages and frameworks. I've contributed to Starship.rs and fht-compositor, and I'm currently working my own projects, namely Jixia, an agentic framework for self-taught courses, and Chikachika, a local-first overlay engine for live streamers written in Rust.",
    practice:
        "I'm currently interested in how we can create better and more usable software for people, and how we can make those standards simple and reproducible. I'm fascinated also by how computer systems work, how we interact with them, and how we respond to these wild new times in history. In my free time, I am also a painter, photographer, and conceptual artist.",
    portraitAlt: "Marceline Belardo taking a mirror photograph with a camera",
    email: {
        address: "marcy@marcelinebelardo.com",
        label: "Email Marceline at marcy@marcelinebelardo.com",
    },
};
const portraitSizes = "(min-width: 55rem) 15vw, (min-width: 35rem) 18vw, 30vw";
---

<BaseLayout
    title="About"
    description="About Marceline Belardo, a software developer working across software, visual culture, research, and writing."
>
    <article class="about-page">
        <header class="about-title">
            <h1 data-ink-hover="text">
                <GlowText>About</GlowText>
            </h1>
        </header>
        <div class="about-introduction">
            <p>{aboutContent.work}</p>
            <p>{aboutContent.practice}</p>
            <a
                data-ink-hover="text"
                href="/marceline-belardo-cv.pdf"
                target="_blank"
                rel="noopener noreferrer"
            >
                <GlowText>View CV (PDF)</GlowText>
            </a>
        </div>
        <div
            class="about-portrait-triptych"
            aria-label="Marceline taking a mirror photograph"
        >
            <figure class="about-portrait-frame">
                <Image
                    src={portraitImage}
                    alt={aboutContent.portraitAlt}
                    class="about-portrait-frame__image"
                    widths={[320, 640, 960, 1280]}
                    sizes={portraitSizes}
                    layout="constrained"
                    priority
                    fit="contain"
                    style="object-fit: contain;"
                />
            </figure>
            <figure class="about-portrait-frame">
                <Image
                    src={portraitImage}
                    alt=""
                    class="about-portrait-frame__image"
                    widths={[320, 640, 960, 1280]}
                    sizes={portraitSizes}
                    layout="constrained"
                    fit="contain"
                    style="object-fit: contain;"
                />
            </figure>
            <figure class="about-portrait-frame">
                <Image
                    src={portraitImage}
                    alt=""
                    class="about-portrait-frame__image"
                    widths={[320, 640, 960, 1280]}
                    sizes={portraitSizes}
                    layout="constrained"
                    fit="contain"
                    style="object-fit: contain;"
                />
            </figure>
        </div>
        <section class="about-practice" aria-label="Approach">
            <p>{aboutContent.introduction}</p>
        </section>
        <p class="about-contact">
            For work, projects, or conversation:
            <a
                href={`mailto:${aboutContent.email.address}`}
                aria-label={aboutContent.email.label}
                data-ink-hover="text"
            >
                <GlowText>{aboutContent.email.address}</GlowText>
            </a>
        </p>
    </article>
</BaseLayout>
