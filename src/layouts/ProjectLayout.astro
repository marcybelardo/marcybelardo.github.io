---
// pattern: Imperative Shell
import type { CollectionEntry } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import "../styles/projects-design.css";

import SquareImage from "../components/SquareImage.astro";
import GlowText from "../components/GlowText.astro";
import BaseLayout from "./BaseLayout.astro";
import { formatDisplayDate } from "../utils/format-date.ts";

type Props = {
  readonly project: CollectionEntry<"project">;
  readonly Content: AstroComponentFactory;
  readonly relatedProjects?: ReadonlyArray<CollectionEntry<"project">>;
  readonly relatedWriting?: ReadonlyArray<CollectionEntry<"blog">>;
};

const {
  project,
  Content,
  relatedProjects = [],
  relatedWriting = [],
} = Astro.props;
const { data } = project;
const projectPath = `/projects/${project.id}/`;
const canonicalUrl = new URL(projectPath, Astro.site).toString();
const projectLinks = [
  data.repositoryUrl && { label: "Repository", href: data.repositoryUrl },
  data.liveUrl && { label: "Live site", href: data.liveUrl },
  data.externalUrl && { label: "External reference", href: data.externalUrl },
].filter(
  (link): link is { label: string; href: string } => Boolean(link),
);
const hasCollaborators = (data.collaborators?.length ?? 0) > 0;
const hasGallery = (data.gallery?.length ?? 0) > 0;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: data.title,
  description: data.description,
  datePublished: data.date.toISOString(),
  keywords: data.disciplines,
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalUrl={canonicalUrl}
  socialType="article"
  structuredData={structuredData}
>
  <article class="project-layout">
    <header class="project-layout__header">
      <h1 data-ink-hover="text"><GlowText>{data.title}</GlowText></h1>

      <div class="project-layout__overview">
        <p class="project-layout__description">{data.description}</p>

        <aside
          class="project-layout__marginalia"
          aria-label={`${data.title} details`}
        >
          <dl class="project-layout__metadata">
            <div>
              <dt class="metadata">Date</dt>
              <dd><time datetime={data.date.toISOString()}>{formatDisplayDate(data.date)}</time></dd>
            </div>
            <div>
              <dt class="metadata">Disciplines</dt>
              <dd>{data.disciplines.join(" · ")}</dd>
            </div>
            {data.status && (
              <div>
                <dt class="metadata">Status</dt>
                <dd>{data.status}</dd>
              </div>
            )}
            {data.role && (
              <div>
                <dt class="metadata">Role</dt>
                <dd>{data.role}</dd>
              </div>
            )}
            {hasCollaborators && (
              <div>
                <dt class="metadata">Collaborators</dt>
                <dd>{data.collaborators?.join(" · ")}</dd>
              </div>
            )}
          </dl>

          {projectLinks.length > 0 && (
            <section class="project-layout__links" aria-labelledby="project-links-heading">
              <h2 id="project-links-heading">Links</h2>
              <ul>
                {projectLinks.map((link) => (
                  <li><a href={link.href} rel="noreferrer">{link.label}</a></li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>
    </header>

    {
      data.coverImage && data.coverImageAlt && (
        <figure class="project-layout__cover">
          <SquareImage
            src={data.coverImage}
            alt={data.coverImageAlt}
            priority
            sizes="(min-width: 50rem) 48rem, calc(100vw - 2rem)"
          />
        </figure>
      )
    }

    <div class="project-layout__body editorial-article">
      <Content />
    </div>

    {
      hasGallery && (
        <section class="project-layout__gallery editorial-section" aria-labelledby="project-gallery-heading">
          <h2 id="project-gallery-heading">Gallery</h2>
          <div class="project-layout__gallery-grid">
            {data.gallery?.map((item) => (
              <figure>
                <SquareImage
                  src={item.image}
                  alt={item.imageAlt}
                  sizes="(min-width: 72rem) 23rem, (min-width: 56rem) 30vw, (min-width: 48rem) 48vw, calc(100vw - 2rem)"
                />
                {item.caption?.trim() && <figcaption>{item.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedProjects.length > 0 && (
        <section class="project-layout__related editorial-section" aria-labelledby="related-projects-heading">
          <h2 id="related-projects-heading">Related projects</h2>
          <ul class="editorial-list">
            {relatedProjects.map((relatedProject) => (
              <li><a href={`/projects/${relatedProject.id}/`}>{relatedProject.data.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatedWriting.length > 0 && (
        <section class="project-layout__related editorial-section" aria-labelledby="related-writing-heading">
          <h2 id="related-writing-heading">Related writing</h2>
          <ul class="editorial-list">
            {relatedWriting.map((post) => (
              <li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
