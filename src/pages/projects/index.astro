---
// pattern: Imperative Shell
import { getCollection, type CollectionEntry } from "astro:content";
import {
  filterPublishedEntries,
  sortByDateDescending,
} from "../../content/content-queries.ts";
import ProjectIndexEntry from "../../components/ProjectIndexEntry.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects: Array<CollectionEntry<"project">> = sortByDateDescending(
  filterPublishedEntries(await getCollection("project"), !import.meta.env.DEV),
);
---

<BaseLayout
  title="Projects"
  description="An editorial index of published software, visual, and research projects by Marceline Belardo."
>
  <article class="editorial-page editorial-measure">
    <header class="editorial-page__header">
      <p class="eyebrow">Selected work</p>
      <h1>Projects</h1>
      <p>Published work across software, visual practice, research, and writing.</p>
    </header>

    <ul class="editorial-list" aria-label="Projects">
      {
        projects.map((project, index) => (
          <li>
            <ProjectIndexEntry project={project} ordinal={index + 1} />
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>
