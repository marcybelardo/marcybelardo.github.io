---
// pattern: Imperative Shell
import BlogAuthorSignature from "../../../components/BlogAuthorSignature.astro";
import SquareImage from "../../../components/SquareImage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import {
  getPublishedBlogPosts,
  toTagSlug,
} from "../../../content/content-queries.ts";
import {
  createStandardSiteDocumentUri,
  SITE_ORIGIN,
} from "../../../site-config.ts";
import { formatDisplayDate } from "../../../utils/format-date.ts";

type Props = {
  readonly post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = getPublishedBlogPosts(
    await getCollection("blog"),
    !import.meta.env.DEV,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
const description = post.data.description;

if (!description) {
  throw new Error(`published blog post is missing a description: ${post.id}`);
}

const canonicalUrl = new URL(
  `/blog/${post.id}/`,
  Astro.site ?? SITE_ORIGIN,
).toString();
// The publisher requires an explicit immutable slug. Legacy title-derived
// route IDs remain renderable, but are not advertised as Standard.site docs.
const standardSiteDocument = post.data.slug
  ? createStandardSiteDocumentUri(post.data.slug)
  : null;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  url: canonicalUrl,
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.tags.length > 0 ? { keywords: post.data.tags } : {}),
  ...(post.data.image
    ? {
        image: new URL(
          post.data.image.src,
          Astro.site ?? SITE_ORIGIN,
        ).toString(),
      }
    : {}),
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  canonicalUrl={canonicalUrl}
  socialType="article"
  standardSiteDocument={standardSiteDocument}
  structuredData={structuredData}
>
  <article
    class="editorial-article editorial-measure blog-article"
    data-margin-note-article
  >
    <header class="editorial-page__header blog-article__header">
      <p class="eyebrow">Writing</p>
      <h1>{post.data.title}</h1>
      <div class="metadata blog-article__metadata">
        <time datetime={post.data.date.toISOString()}>
          {
            formatDisplayDate(post.data.date)
          }
        </time>
        {post.data.tags.length > 0 && (
          <span>
            {post.data.tags.map((tag, i) => [
              i > 0 && ", ",
              (() => {
                const slug = toTagSlug(tag);

                return slug ? (
                  <a href={`/blog/tags/${slug}/`}>
                    {tag}
                  </a>
                ) : null;
              })(),
            ])}
          </span>
        )}
      </div>
    </header>
    {post.data.image && post.data.imageAlt && (
      <SquareImage
        src={post.data.image}
        alt={post.data.imageAlt}
        class="blog-article__image"
      />
    )}
    <div class="blog-article__body">
      <Content />
    </div>
    <BlogAuthorSignature />
    <aside
      class="margin-note-rail"
      data-margin-note-rail
      aria-label="Margin notes"
      aria-hidden="true"
    >
      <ol aria-label="Margin notes"></ol>
    </aside>
  </article>
</BaseLayout>

<script>
  import { initializeMarginNotes } from "../../../scripts/margin-notes.ts";

  initializeMarginNotes();
</script>
