---
// pattern: Imperative Shell
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { filterPublishedEntries } from "../../../content/content-queries.ts";
import { SITE_ORIGIN } from "../../../site-config.ts";

type Props = {
  readonly post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = filterPublishedEntries(
    await getCollection("blog"),
    !import.meta.env.DEV,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
const description = post.data.description ?? "";
const canonicalUrl = new URL(
  `/blog/${post.id}/`,
  Astro.site ?? SITE_ORIGIN,
).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  url: canonicalUrl,
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  keywords: post.data.tags,
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  canonicalUrl={canonicalUrl}
  socialType="article"
  structuredData={structuredData}
>
  <article class="py-12 mx-auto max-w-2xl">
    <time
      class="text-sm text-neutral-500"
      datetime={post.data.date.toISOString()}
    >
      {
        post.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </time>
    <h1 class="text-3xl font-bold text-neutral-900 mt-1 mb-2">
      {post.data.title}
    </h1>
    {post.data.tags && post.data.tags.length > 0 && (
      <p class="text-sm italic text-neutral-400 mb-6">
        {post.data.tags.map((tag: string, i: number) => [
          i > 0 && ", ",
          <a
            href={`/blog/tags/${tag.toLowerCase()}/`}
            class="hover:text-neutral-600 underline"
          >
            {tag}
          </a>,
        ])}
      </p>
    )}
    <div class="prose text-neutral-700 leading-relaxed space-y-4">
      <Content />
    </div>
  </article>
</BaseLayout>
