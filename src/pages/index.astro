---
import PhotoStudy from "../components/PhotoStudy.astro";
import GlowText from "../components/GlowText.astro";
import "../styles/home-design.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_ORIGIN } from "../site-config.ts";
const canonicalUrl = new URL("/", Astro.site ?? SITE_ORIGIN).toString();
const profileUrls = [
  "https://github.com/marcybelardo",
  "https://bsky.app/profile/marcelinebelardo.com",
  "https://instagram.com/marcelinebelardo",
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: "Marceline Belardo",
    },
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      url: canonicalUrl,
      name: "Marceline Belardo",
      sameAs: profileUrls,
    },
  ],
};
---
<BaseLayout
  title="Marceline Belardo"
  description="Marceline Belardo is a software developer, photographer, and painter."
  structuredData={structuredData}
>
  <article class="portfolio-home">
    <h1 data-ink-hover="text"><GlowText>Marceline Belardo</GlowText></h1>
    <PhotoStudy />
    <nav class="home-directions" aria-label="Explore the site">
      <a href="/projects/" data-ink-hover="text"><GlowText>Projects</GlowText></a>
      <a href="/blog/" data-ink-hover="text"><GlowText>Blog</GlowText></a>
      <a href="/bio/" data-ink-hover="text"><GlowText>Bio</GlowText></a>
      <a href="/contact/" data-ink-hover="text"><GlowText>Contact</GlowText></a>
    </nav>
  </article>
</BaseLayout>
