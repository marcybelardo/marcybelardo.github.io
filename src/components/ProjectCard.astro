---
interface Props {
  title: string;
  description: string;
  tags?: string[];
}

const { title, description, tags = [] } = Astro.props;
---

<div class="border border-neutral-200 p-5">
  <h3 class="text-lg font-semibold text-neutral-900 mb-2">{title}</h3>
  <p class="text-sm text-neutral-600 leading-relaxed mb-3">{description}</p>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="text-xs font-medium text-neutral-500 bg-neutral-100 px-2.5 py-1">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</div>
