---
// pattern: Imperative Shell
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  readonly src: ImageMetadata;
  readonly alt: string;
  readonly class?: string;
  readonly priority?: boolean;
  readonly sizes?: string;
};

const {
  src,
  alt,
  class: className,
  priority = false,
  sizes = "100vw",
} = Astro.props;
---

<div class:list={["square-image", className]} style="aspect-ratio: 1;">
  <Image
    src={src}
    alt={alt}
    class="square-image__image"
    widths={[320, 640, 960, 1280]}
    sizes={sizes}
    layout="constrained"
    priority={priority}
    fit="contain"
    style="object-fit: contain;"
  />
</div>

<style>
  .square-image {
    display: block;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-rule) 18%, var(--color-paper));
  }

  .square-image__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
