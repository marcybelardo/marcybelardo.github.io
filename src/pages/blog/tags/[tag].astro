---
// pattern: Imperative Shell
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  getBlogTagArchives,
  type BlogTagArchive,
} from "../../../content/content-queries.ts";

type Props = {
  readonly tag: BlogTagArchive<CollectionEntry<"blog">>;
};

export async function getStaticPaths() {
  const archives = getBlogTagArchives(
    await getCollection("blog"),
    !import.meta.env.DEV,
  );

  return archives.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props as Props;
const { label, posts } = tag;
---

<BaseLayout
  title={`Posts tagged: ${label}`}
  description={`Writing by Marceline Belardo tagged with ${label}.`}
>
  <article class="editorial-page editorial-measure">
    <header class="editorial-page__header">
      <p class="eyebrow"><a href="/blog/">Blog archive</a></p>
      <h1>Posts tagged: <span class="accent">{label}</span></h1>
    </header>
    {
      posts.length === 0 ? (
        <p class="editorial-empty">No posts found.</p>
      ) : (
        <ul class="editorial-list blog-index__list" aria-label={`Posts tagged ${label}`}>
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                <h2>{post.data.title}</h2>
              </a>
              <time
                class="metadata"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              {post.data.description && (
                <p class="blog-index__description">
                  {post.data.description}
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
