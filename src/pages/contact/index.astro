---
// pattern: Imperative Shell
import GlowText from "../../components/GlowText.astro";
import "../../styles/contact-design.css";
import BaseLayout from "../../layouts/BaseLayout.astro";

const contactDestinations = {
  email: {
    label: "Email Marceline at marcy@marcelinebelardo.com",
    href: "mailto:marcy@marcelinebelardo.com",
  },
  profiles: [
    { label: "GitHub", accessibleLabel: "GitHub profile", href: "https://github.com/marcybelardo" },
    {
      label: "Bluesky",
      accessibleLabel: "Bluesky profile",
      href: "https://bsky.app/profile/marcelinebelardo.com",
    },
    {
      label: "Instagram",
      accessibleLabel: "Instagram profile",
      href: "https://instagram.com/marcelinebelardo",
    },
  ],
};
---

<BaseLayout
  title="Contact"
  description="Contact Marceline Belardo by email or through verified GitHub, Bluesky, and Instagram profiles."
>
  <article class="contact-page">
    <header class="contact-page__heading">
      <h1 data-ink-hover="text"><GlowText>Contact</GlowText></h1>
    </header>

    <a
      class="contact-page__email"
      href={contactDestinations.email.href}
      aria-label={contactDestinations.email.label}
      data-ink-hover="text"
    >
      <GlowText>marcy@marcelinebelardo.com</GlowText>
    </a>

    <nav aria-label="Social profiles" class="contact-page__profiles">
      <ul>
        {contactDestinations.profiles.map((destination) => (
          <li>
            <a
              href={destination.href}
              aria-label={destination.accessibleLabel}
            >
              {destination.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </article>
</BaseLayout>
