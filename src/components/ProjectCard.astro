---
interface Props {
  title: string;
  description: string;
  tags?: string[];
  href: string;
}

const { title, description, tags = [], href } = Astro.props;
---

<a href={href} class="h-full no-underline">
  <div class="border border-neutral-900 p-5 h-full flex flex-col">
    <h3 class="text-lg font-semibold text-neutral-900 mb-2">{title}</h3>
    <p class="accent text-sm text-neutral-600 mb-3">{description}</p>
    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-2 mt-auto">
          {tags.map((tag) => (
            <li class="text-xs font-medium text-neutral-700 px-2.5 py-1">
              {tag}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</a>
