---
// pattern: Imperative Shell
import { Image } from "astro:assets";
import GlowText from "../../components/GlowText.astro";
import portraitImage from "../../assets/marcy_mirror.jpg";
import "../../styles/about-design.css";
import BaseLayout from "../../layouts/BaseLayout.astro";

const aboutContent = {
    introduction:
        "I am Marceline, computer science and mathematics student, writer, and artist based in Makati City, Philippines. Currently completing the Diploma of Computer Science at the University of the Philippines, and looking forward to future mathematics study and graduate research.",
    work: "My work revolves around critical views of technology, AI, and computing. I am especially interested in how new technologies and modes of understanding change the way we live, and how these things relate to our visual and aesthetic experiences. I also maintain a visual practice in painting, photography, and conceptual art.",
    practice:
        "Before returning to formal study, I worked across software engineering, open source, and client web/data work—mostly in Rust, Python, and TypeScript. That technical background grounds my current experiments, including Jixia (an agentic harness for self-directed study) and Chikachika (a local-first streaming overlay engine in Rust).",
    portraitAlt: "Marceline Belardo taking a mirror photograph with a camera",
    email: {
        address: "marcy@marcelinebelardo.com",
        label: "Email Marceline at marcy@marcelinebelardo.com",
    },
};
const portraitSizes = "(min-width: 55rem) 15vw, (min-width: 35rem) 18vw, 30vw";
---

<BaseLayout
    title="About"
    description="About Marceline Belardo, computer science and mathematics student, writer, and artist reflecting on technology and philosophy"
>
    <article class="about-page">
        <header class="about-title">
            <h1 data-ink-hover="text">
                <GlowText>About</GlowText>
            </h1>
        </header>
        <div class="about-introduction">
            <p>{aboutContent.work}</p>
            <p>{aboutContent.practice}</p>
        </div>
        <div
            class="about-portrait-triptych"
            aria-label="Marceline taking a mirror photograph"
        >
            <figure class="about-portrait-frame">
                <Image
                    src={portraitImage}
                    alt={aboutContent.portraitAlt}
                    class="about-portrait-frame__image"
                    widths={[320, 640, 960, 1280]}
                    sizes={portraitSizes}
                    layout="constrained"
                    priority
                    fit="contain"
                    style="object-fit: contain;"
                />
            </figure>
            <figure class="about-portrait-frame">
                <Image
                    src={portraitImage}
                    alt=""
                    class="about-portrait-frame__image"
                    widths={[320, 640, 960, 1280]}
                    sizes={portraitSizes}
                    layout="constrained"
                    fit="contain"
                    style="object-fit: contain;"
                />
            </figure>
            <figure class="about-portrait-frame">
                <Image
                    src={portraitImage}
                    alt=""
                    class="about-portrait-frame__image"
                    widths={[320, 640, 960, 1280]}
                    sizes={portraitSizes}
                    layout="constrained"
                    fit="contain"
                    style="object-fit: contain;"
                />
            </figure>
        </div>
        <section class="about-practice" aria-label="Approach">
            <p>{aboutContent.introduction}</p>
        </section>
        <p class="about-contact">
            For correspondence, collaborations, or select project work:
            <a
                href={`mailto:${aboutContent.email.address}`}
                aria-label={aboutContent.email.label}
                data-ink-hover="text"
            >
                <GlowText>{aboutContent.email.address}</GlowText>
            </a>
            ·
            <a
                data-ink-hover="text"
                href="/marceline-belardo-cv.pdf"
                target="_blank"
                rel="noopener noreferrer"
            >
                <GlowText>CV (PDF)</GlowText>
            </a>
        </p>
    </article>
</BaseLayout>
