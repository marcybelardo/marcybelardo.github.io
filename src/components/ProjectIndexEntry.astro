---
// pattern: Imperative Shell
import type { CollectionEntry } from "astro:content";

import GlowText from "./GlowText.astro";
import SquareImage from "./SquareImage.astro";

type Props = {
  readonly project: CollectionEntry<"project">;
  readonly ordinal: number;
};

const { project, ordinal } = Astro.props;
const { data } = project;
const year = data.date.getFullYear();
const projectUrl = `/projects/${project.id}/`;
const hasCover = Boolean(data.coverImage && data.coverImageAlt);
---

<article
  class:list={[
    "project-index-entry",
    hasCover && "project-index-entry--has-cover",
  ]}
>
  {
    data.coverImage && data.coverImageAlt && (
      <SquareImage
        src={data.coverImage}
        alt={data.coverImageAlt}
        class="project-index-entry__image"
        sizes="(min-width: 72rem) 12rem, (min-width: 48rem) 10rem, 12rem"
      />
    )
  }

  <p class="project-index-entry__ordinal">
    <span aria-hidden="true">{String(ordinal).padStart(2, "0")}</span>
    <time datetime={data.date.toISOString()}>{year}</time>
  </p>

  <div class="project-index-entry__main">
    <h2>
      <a href={projectUrl} data-ink-hover="text"><GlowText>{data.title}</GlowText></a>
    </h2>
    <p class="project-index-entry__description">{data.description}</p>
  </div>

  <aside
    class="project-index-entry__metadata"
    aria-label={`${data.title} details`}
  >
    <dl>
      <div>
        <dt>Disciplines</dt>
        <dd>{data.disciplines.join(" · ")}</dd>
      </div>
      {data.status && (
        <div>
          <dt>Status</dt>
          <dd>{data.status}</dd>
        </div>
      )}
      {data.tags.length > 0 && (
        <div>
          <dt>Tags</dt>
          <dd>{data.tags.join(" · ")}</dd>
        </div>
      )}
    </dl>
  </aside>
</article>
