---
// pattern: Imperative Shell
import SquareImage from "../../../components/SquareImage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import {
  getPublishedBlogPosts,
  toTagSlug,
} from "../../../content/content-queries.ts";
import { SITE_ORIGIN } from "../../../site-config.ts";

type Props = {
  readonly post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = getPublishedBlogPosts(
    await getCollection("blog"),
    !import.meta.env.DEV,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
const description = post.data.description;

if (!description) {
  throw new Error(`published blog post is missing a description: ${post.id}`);
}

const canonicalUrl = new URL(
  `/blog/${post.id}/`,
  Astro.site ?? SITE_ORIGIN,
).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  url: canonicalUrl,
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.tags.length > 0 ? { keywords: post.data.tags } : {}),
  ...(post.data.image
    ? {
        image: new URL(
          post.data.image.src,
          Astro.site ?? SITE_ORIGIN,
        ).toString(),
      }
    : {}),
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  canonicalUrl={canonicalUrl}
  socialType="article"
  structuredData={structuredData}
>
  <article
    class="py-12 mx-auto max-w-2xl blog-article"
    data-margin-note-article
  >
    <time
      class="text-sm text-neutral-500"
      datetime={post.data.date.toISOString()}
    >
      {
        post.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </time>
    <h1 class="text-3xl font-bold text-neutral-900 mt-1 mb-2">
      {post.data.title}
    </h1>
    {post.data.tags && post.data.tags.length > 0 && (
      <p class="text-sm italic text-neutral-400 mb-6">
        {post.data.tags.map((tag, i) => [
          i > 0 && ", ",
          (() => {
            const slug = toTagSlug(tag);

            return slug ? (
              <a
                href={`/blog/tags/${slug}/`}
                class="hover:text-neutral-600 underline"
              >
                {tag}
              </a>
            ) : null;
          })(),
        ])}
      </p>
    )}
    {post.data.image && post.data.imageAlt && (
      <SquareImage
        src={post.data.image}
        alt={post.data.imageAlt}
        class="blog-article__image"
      />
    )}
    <div class="prose text-neutral-700 leading-relaxed space-y-4">
      <Content />
    </div>
    <aside
      class="margin-note-rail"
      data-margin-note-rail
      aria-label="Margin notes"
      aria-hidden="true"
    >
      <ol aria-label="Margin notes"></ol>
    </aside>
  </article>
</BaseLayout>

<script>
  import { initializeMarginNotes } from "../../../scripts/margin-notes.ts";

  initializeMarginNotes();
</script>
