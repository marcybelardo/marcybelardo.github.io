---
import PhotoStudy from "../components/PhotoStudy.astro";
import "../styles/home-design.css";
import "../styles/ink-hover.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_ORIGIN } from "../site-config.ts";
const canonicalUrl = new URL("/", Astro.site ?? SITE_ORIGIN).toString();
const profileUrls = [
  "https://github.com/marcybelardo",
  "https://bsky.app/profile/marcelinebelardo.com",
  "https://instagram.com/marcelinebelardo",
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: "Marceline Belardo",
    },
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#person`,
      url: canonicalUrl,
      name: "Marceline Belardo",
      sameAs: profileUrls,
    },
  ],
};
---
<BaseLayout
  title="Marceline Belardo"
  description="Marceline Belardo is a software developer, photographer, and painter."
  structuredData={structuredData}
>
  <article class="portfolio-home">
    <h1 data-ink-hover="text"><span class="ink-hover__glow-copy" aria-hidden="true">Marceline Belardo</span><span class="ink-hover__foreground">Marceline Belardo</span></h1>
    <PhotoStudy />
    <nav class="home-directions" aria-label="Explore the site">
      <a href="/projects/" data-ink-hover="text"><span class="ink-hover__glow-copy" aria-hidden="true">Projects</span><span class="ink-hover__foreground">Projects</span></a>
      <a href="/blog/" data-ink-hover="text"><span class="ink-hover__glow-copy" aria-hidden="true">Blog</span><span class="ink-hover__foreground">Blog</span></a>
      <a href="/bio/" data-ink-hover="text"><span class="ink-hover__glow-copy" aria-hidden="true">Bio</span><span class="ink-hover__foreground">Bio</span></a>
      <a href="/contact/" data-ink-hover="text"><span class="ink-hover__glow-copy" aria-hidden="true">Contact</span><span class="ink-hover__foreground">Contact</span></a>
    </nav>
  </article>
</BaseLayout>

<script>
  import { initializeInkHover } from "../scripts/ink-hover.ts";

  initializeInkHover();
</script>
